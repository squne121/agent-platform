{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-protocol:issue-execution-decision:v1",
  "title": "ISSUE_EXECUTION_DECISION_V1",
  "description": "Canonical static decision shape. Semantic invariants and canonical digest verification are owned by the normative validator in Issue #1677.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "nodes",
    "relations",
    "execution",
    "downstream_policy",
    "completeness"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ISSUE_EXECUTION_DECISION_V1"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "downstream_policy": {
      "$ref": "#/$defs/downstream_policy"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_issue_number",
        "target_body_sha256",
        "generated_at",
        "collection_digest"
      ],
      "properties": {
        "target_issue_number": {
          "$ref": "#/$defs/issue_number"
        },
        "target_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "collection_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_number",
        "body_sha256"
      ],
      "properties": {
        "issue_number": {
          "$ref": "#/$defs/issue_number"
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_issue_number",
        "target_issue_number",
        "relation_type",
        "evidence"
      ],
      "properties": {
        "source_issue_number": {
          "$ref": "#/$defs/issue_number"
        },
        "target_issue_number": {
          "$ref": "#/$defs/issue_number"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "depends_on",
            "duplicate",
            "absorb",
            "supersedes",
            "coordinates"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "target_issue_number",
        "predecessors",
        "defer_reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "selected",
            "deferred",
            "blocked",
            "duplicate"
          ]
        },
        "target_issue_number": {
          "$ref": "#/$defs/issue_number"
        },
        "predecessors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue_number"
          }
        },
        "defer_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "downstream_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_reclassification",
        "freshness_validation",
        "stale_action"
      ],
      "properties": {
        "semantic_reclassification": {
          "type": "string",
          "const": "forbidden"
        },
        "freshness_validation": {
          "type": "string",
          "const": "required"
        },
        "stale_action": {
          "type": "string",
          "const": "rerun_issue_refinement"
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues_complete",
        "dependencies_complete",
        "unresolved_references"
      ],
      "properties": {
        "issues_complete": {
          "type": "boolean"
        },
        "dependencies_complete": {
          "type": "boolean"
        },
        "unresolved_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue_number"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "producer",
        "collector",
        "canonicalization_id",
        "digests",
        "legacy_compatibility"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "$ref": "#/$defs/component_version"
        },
        "collector": {
          "$ref": "#/$defs/component_version"
        },
        "canonicalization_id": {
          "type": "string",
          "minLength": 1
        },
        "digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_manifest_sha256",
            "semantic_decision_sha256",
            "artifact_sha256"
          ],
          "properties": {
            "source_manifest_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "semantic_decision_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "legacy_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_schema_identifiers",
            "supported_consumer_versions"
          ],
          "properties": {
            "legacy_schema_identifiers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supported_consumer_versions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "component_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "legacy_digest",
        "new_digest",
        "equivalence_result",
        "producer_version",
        "consumer_capability"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "dual_write",
            "equivalence",
            "dual_read",
            "new_authoritative",
            "legacy_removed"
          ]
        },
        "legacy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_digest": {
          "$ref": "#/$defs/sha256"
        },
        "equivalence_result": {
          "type": "string",
          "enum": [
            "equivalent",
            "not_equivalent",
            "not_applicable"
          ]
        },
        "producer_version": {
          "type": "string",
          "minLength": 1
        },
        "consumer_capability": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
